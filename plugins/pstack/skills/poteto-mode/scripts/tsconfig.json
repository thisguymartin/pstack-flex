{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "types": [
      "bun-types"
    ]
  },
  "include": [
    "harnesses.ts",
    "configuration*.ts",
    "context.ts",
    "runner/*.ts"
  ]
}
